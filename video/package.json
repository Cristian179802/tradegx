{
  "name": "@tradegx/video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tooling de captura si montaj pentru materialele video TradeGX. Nu face parte din build-ul aplicatiei.",
  "scripts": {
    "setup:wsl": "bash setup-wsl.sh",
    "capture": "./entrypoint.sh tsx capture/run.ts",
    "capture:raw": "tsx capture/run.ts",
    "studio:build": "docker build -t tradegx-studio .",
    "studio:run": "docker run --rm --shm-size=1g -v \"$PWD/out:/studio/out\" tradegx-studio",
    "studio": "npm run studio:build && npm run studio:run",
    "direct": "./entrypoint.sh tsx director.ts",
    "direct:raw": "tsx director.ts",
    "direct:dry": "tsx director.ts --dry",
    "local:build": "bash local-server.sh build",
    "local:start": "bash local-server.sh start",
    "local:stop": "bash local-server.sh stop",
    "local:verifica": "bash local-server.sh verifica",
    "film": "bash film.sh",
    "local:db": "bash local-db.sh"
  },
  "dependencies": {
    "playwright": "1.56.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
